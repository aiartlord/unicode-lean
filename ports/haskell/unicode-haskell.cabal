cabal-version:      3.0
name:               unicode-haskell
version:            0.2.0
synopsis:           Haskell port of the Unicode security runtime — UCD 17.0.0 codecs and validators
description:
  Strict UTF-8 / UTF-16 / UTF-32 codecs, BOM detection, noncharacter
  detection, strict-ASCII identifiers, UTF-8 blob and validated-UTF-8
  refinement types. Algorithmic re-implementation of the unicode-lean
  reference in pure Haskell, validated against the same per-module
  theorems and the UCD 17.0.0 conformance fixtures.
  .
  Phase 2 (current release): every table-free codec from
  unicode-lean's @Unicode/Codec/@ tree. UCD-table-backed atoms
  (UAX #31 default identifier, RFC 8264/8265 PRECIS profiles, the
  printable-UTF-8 profile) ship in a later phase once the table-
  codegen path lands.
license:            MIT
license-file:       LICENSE
author:             jpyxal
maintainer:         pyxalpendant@gmail.com
copyright:          2026 jpyxal
category:           Text
build-type:         Simple
extra-doc-files:    README.md
extra-source-files:
  data/UCD-VERSION
  data/SHA256SUMS
  testdata/fixtures/security/*.json
  testdata/fixtures/security/detectors/*.json
data-files:
  data/CaseFolding.txt
  data/confusables.txt
  data/KnownAttackTargets.txt
  data/StandardizedVariants.txt
  data/emoji-variation-sequences.txt
  data/emoji-data.txt
  data/emoji-zwj-sequences.txt
  data/UnicodeData.txt
  data/SpecialCasing.txt
  data/DerivedCoreProperties.txt
  data/IdentifierStatus.txt
  data/bip39/chinese_simplified.txt
  data/bip39/chinese_traditional.txt
  data/bip39/czech.txt
  data/bip39/english.txt
  data/bip39/french.txt
  data/bip39/italian.txt
  data/bip39/japanese.txt
  data/bip39/korean.txt
  data/bip39/portuguese.txt
  data/bip39/spanish.txt
tested-with:        GHC == 9.12.*

common warnings
  default-language: GHC2021
  default-extensions:
      BangPatterns
      DataKinds
      DerivingStrategies
      StrictData
  ghc-options:
      -Wall
      -Werror
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-import-lists
      -Wpartial-fields
      -Wredundant-constraints
      -Wunused-packages

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
      Unicode.Casing
      Unicode.Codec.Bom
      Unicode.Codec.Identifier
      Unicode.Codec.Noncharacters
      Unicode.Codec.OpaqueBlob
      Unicode.Codec.Strict
      Unicode.Codec.Utf8
      Unicode.Codec.Utf16
      Unicode.Codec.Utf32
      Unicode.Codec.ValidatedUtf8
      Unicode.Generated.CompositionExclusions
      Unicode.Generated.DerivedBidiClass
      Unicode.Generated.DerivedNormalizationProps
      Unicode.Generated.UnicodeData
      Unicode.Normalization.CompatDecompose
      Unicode.Normalization.Compose
      Unicode.Normalization.Hangul
      Unicode.Normalization.Lookup
      Unicode.Normalization.NFC
      Unicode.Normalization.NFD
      Unicode.Normalization.NFKC
      Unicode.Normalization.NFKD
      Unicode.Normalization.Reorder
      Unicode.Segmentation.Grapheme
      Unicode.Segmentation.GraphemeTables
      Unicode.Security.Crypto.AiWatermarkDetectability
      Unicode.Security.Crypto.Bip39Canonical
      Unicode.Security.Boundary.AdmissibilityFormDrift
      Unicode.Security.Boundary.IdentifierFormDrift
      Unicode.Security.Crypto.HashInputStability
      Unicode.Security.Display.RendererDivergence
      Unicode.Security.Display.FilenameDisguise
      Unicode.Security.Display.SourceDisplayDivergence
      Unicode.Security.Form.CaseExpansionMismatch
      Unicode.Security.Form.LocaleCaseInversion
      Unicode.Security.Form.NfcIdempotenceWitness
      Unicode.Security.Form.NormalizationBomb
      Unicode.Security.Form.StreamSafeViolation
      Unicode.Security.Identity.EmojiZwjIntegrity
      Unicode.Security.Identity.SkinToneVariationForgery
      Unicode.Security.Policy
  other-modules:
      Paths_unicode_haskell
  build-depends:
      base        >=4.18  && <5
    , bytestring  >=0.11  && <0.13
    , containers  >=0.6   && <0.8

test-suite unicode-haskell-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  other-modules:
      AiWatermarkDetectabilitySpec
      Bip39CanonicalSpec
      HashInputStabilitySpec
      BomSpec
      CaseExpansionMismatchSpec
      CasingSpec
      HangulSpec
      GraphemeSpec
      IdentifierSpec
      LocaleCaseInversionSpec
      LookupSpec
      NfcIdempotenceWitnessSpec
      NFKDSpec
      NoncharactersSpec
      NormalizationBombSpec
      StreamSafeViolationSpec
      OpaqueBlobSpec
      PolicySpec
      ConfusableBidiCompoundSpec
      CovertDisplayCompoundSpec
      EmojiZwjIntegritySpec
      RendererDivergenceSpec
      FilenameDisguiseSpec
      SourceDisplayDivergenceSpec
      AdmissibilityFormDriftSpec
      IdentifierFormDriftSpec
      SkinToneVariationForgerySpec
      Utf8Spec
      Utf16Spec
      Utf32Spec
      ValidatedUtf8Spec
  build-depends:
      base               >=4.18 && <5
    , bytestring         >=0.11 && <0.13
    , tasty              >=1.4  && <1.6
    , tasty-hunit        >=0.10 && <0.11
    , tasty-quickcheck   >=0.10 && <0.12
    , QuickCheck         >=2.14 && <2.16
    , unicode-haskell
