/-
  Unicode.Generated.EmojiSequencesData

  Materialized RGI emoji-sequence rows (UTS #51 17.0.0), extracted from
  `emoji-sequences.txt` + `emoji-zwj-sequences.txt` and pinned as a `List`
  literal so the per-type sequence tables and membership tests reduce in
  the kernel. The parsers and `include_str` sources live in
  `Unicode.Generated.EmojiSequences`, which imports this module and
  carries the build-time drift gate.
-/

namespace Unicode.Generated.EmojiSequences

set_option maxRecDepth 1000000

/-- The RGI emoji-sequence property types per UTS #51. -/
inductive RgiSequenceType where
  | Basic_Emoji
  | Emoji_Keycap_Sequence
  | RGI_Emoji_Flag_Sequence
  | RGI_Emoji_Modifier_Sequence
  | RGI_Emoji_Tag_Sequence
  | RGI_Emoji_ZWJ_Sequence
  deriving DecidableEq, Repr, Inhabited

/-- One parsed RGI-sequence row: the codepoint sequence, its type, and
    (for Basic_Emoji range rows) the range upper bound. -/
structure SequenceRow where
  seq  : List Nat
  type : RgiSequenceType
  rangeMax : Nat
  deriving Repr, Inhabited, DecidableEq

/-- Materialized RGI-sequence rows in source order (emoji-sequences
    then emoji-zwj-sequences). Downstream per-type tables `filter`/`map`
    over this `List`; a `List.any` membership test reduces linearly in
    the kernel. -/
