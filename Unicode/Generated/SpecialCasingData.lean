/-
  Unicode.Generated.SpecialCasingData

  Materialized SpecialCasing.txt rows (UCD 17.0.0), pinned as a `List`
  literal so per-codepoint case-mapping lookups reduce in the kernel. The
  parser and `include_str` source live in `Unicode.Generated.SpecialCasing`,
  which imports this module and carries the build-time drift gate. The
  `Condition`/`Row` types are defined here to avoid a circular import.
-/

namespace Unicode.Generated.SpecialCasing

set_option maxRecDepth 1000000

/-- A `SpecialCasing.txt` condition token. -/
inductive Condition where
  | LangTr
  | LangAz
  | LangLt
  | FinalSigma
  | NotFinalSigma
  | AfterSoftDotted
  | MoreAbove
  | NotBeforeDot
  | AfterI
  | Other (token : String)
  deriving Repr, Inhabited, DecidableEq

/-- One parsed SpecialCasing row: source code point and its full
    lower / title / upper mappings plus any locale/context conditions. -/
structure Row where
  code       : Nat
  lower      : Array Nat
  title      : Array Nat
  upper      : Array Nat
  conditions : Array Condition
  deriving Repr, Inhabited, DecidableEq

