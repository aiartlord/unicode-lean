/-
  Unicode.Generated.IdnaMappingData

  Materialized IdnaMappingTable.txt rows (UCD 17.0.0), sorted by `min`, as a
  `List` literal so the range table reduces in the kernel. The parser and
  `include_str` source live in `Unicode.Generated.IdnaMapping`, which imports
  this module and carries the build-time drift gate. The IDNA types are
  defined here to avoid a circular import.
-/

namespace Unicode.Generated.IdnaMapping

set_option maxRecDepth 1000000
set_option maxHeartbeats 10000000

/-- UTS #46 disposition of a codepoint. -/
inductive IdnaDisposition where
  | Valid
  | Mapped
  | Ignored
  | Deviation
  | Disallowed
  deriving DecidableEq, Repr, Inhabited

/-- IDNA2008 status annotation (NV8 / XV8). -/
inductive IdnaIdna2008Status where
  | NV8
  | XV8
  deriving DecidableEq, Repr, Inhabited

/-- One row of the IDNA mapping table. -/
structure IdnaRow where
  min          : Nat
  max          : Nat
  disposition  : IdnaDisposition
  mapping      : List Nat
  idna2008     : Option IdnaIdna2008Status
  deriving Repr, Inhabited, DecidableEq

