/-- Binary search over the sorted explicit General_Category range table. -/
def binarySearch (cp : Nat) (left right fuel : Nat) : GC :=
  match fuel with
  | 0 => defaultGC
  | fuelNext + 1 =>
    if left < right then
      let mid := (left + right) / 2
      let row := gcRanges[mid]!
      let lo := row.1
      let hi := row.2.1
      let gc := row.2.2
      if cp < lo then
        binarySearch cp left mid fuelNext
      else if hi < cp then
        binarySearch cp (mid + 1) right fuelNext
      else
        gc
    else
      defaultGC

/-- Look up the General_Category for a codepoint, defaulting to `Cn`. -/
def lookup (cp : Nat) : GC :=
  binarySearch cp 0 gcRanges.length (gcRanges.length + 1)

theorem lookup_u0000 : lookup 0x0000 = .Cc := by decide
theorem lookup_u0020 : lookup 0x0020 = .Zs := by decide
theorem lookup_u0024 : lookup 0x0024 = .Sc := by decide
theorem lookup_u0028 : lookup 0x0028 = .Ps := by decide
theorem lookup_u002B : lookup 0x002B = .Sm := by decide
theorem lookup_u002D : lookup 0x002D = .Pd := by decide
theorem lookup_u0030 : lookup 0x0030 = .Nd := by decide
theorem lookup_u0041 : lookup 0x0041 = .Lu := by decide
