/-- Binary search over the sorted compatibility-decomposition rows. -/
def binarySearch (cp : Nat) (left right fuel : Nat) : Option CompatDecompRow :=
  match fuel with
  | 0 => none
  | fuelNext + 1 =>
    if left < right then
      let mid := (left + right) / 2
      let row := compatDecompRows[mid]!
      if cp < row.codepoint then
        binarySearch cp left mid fuelNext
      else if row.codepoint < cp then
        binarySearch cp (mid + 1) right fuelNext
      else
        some row
    else
      none

/-- Lookup a compatibility-decomposition row by source codepoint. -/
def lookup? (cp : Nat) : Option CompatDecompRow :=
  binarySearch cp 0 compatDecompRows.length (compatDecompRows.length + 1)

