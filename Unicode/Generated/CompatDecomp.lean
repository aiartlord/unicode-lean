-- INTEGRITY GATE — the materialized `compatDecompRows` must equal a fresh parse
-- of column 5 of the pinned UnicodeData.txt. A drifted or stale table aborts
-- the build.
-- ═══════════════════════════════════════════════════════════════════════════════

/-- Raw text of `UnicodeData.txt`, embedded at compile time. -/
def unicodeDataRaw : String := include_str "../Ucd/UnicodeData.txt"

def gHexVal (c : Char) : Nat :=
  let n := c.toNat
  if n ≥ 0x30 ∧ n ≤ 0x39 then n - 0x30
  else if n ≥ 0x61 ∧ n ≤ 0x66 then n - 0x61 + 10
  else if n ≥ 0x41 ∧ n ≤ 0x46 then n - 0x41 + 10
  else 0

def gHex (s : String) : Nat := s.foldl (fun acc c => acc * 16 + gHexVal c) 0

def gTrim (s : String) : String := (String.trimAscii s).toString

def gTag : String → Option CompatTag
  | "circle" => some .Circle     | "compat" => some .Compat
  | "final" => some .Final       | "font" => some .Font
  | "fraction" => some .Fraction | "initial" => some .Initial
  | "isolated" => some .Isolated | "medial" => some .Medial
  | "narrow" => some .Narrow     | "noBreak" => some .NoBreak
  | "small" => some .Small       | "square" => some .Square
  | "sub" => some .Sub           | "super" => some .Super
  | "vertical" => some .Vertical | "wide" => some .Wide
  | _unknownTag => none

/-- Parse one UnicodeData row into a compatibility-decomposition row. -/
def gParseRow (line : String) : Option CompatDecompRow :=
  let fields := line.splitOn ";"
  if fields.length < 6 then none else
  let decomp := gTrim fields[5]!
  if decomp.isEmpty then none
  else if !decomp.startsWith "<" then none
  else
    let chars := decomp.toList
    let closeIdx := chars.findIdx (· == '>')
    let tagName := String.ofList ((chars.drop 1).take (closeIdx - 1))
    match gTag tagName with
    | none => none
    | some tag =>
      let rest := gTrim (String.ofList (chars.drop (closeIdx + 1)))
      let mapping := ((rest.splitOn " ").filterMap (fun tok =>
        let t := gTrim tok
        if t.isEmpty then none else some (gHex t)))
      some { codepoint := gHex (gTrim fields[0]!), tag := tag, mapping := mapping }

/-- Fresh parse of the pinned source, used only by the drift gate. -/
def compatDecompRowsParsed : List CompatDecompRow :=
  ((unicodeDataRaw.splitOn "\n").filterMap gParseRow)

#eval do
  unless compatDecompRows == compatDecompRowsParsed do
    throw (IO.userError "CompatDecomp drift: compatDecompRows ≠ parsed UnicodeData.txt column 5")

end Unicode.Generated.CompatDecomp
