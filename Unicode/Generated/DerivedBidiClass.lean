-- ═══════════════════════════════════════════════════════════════════════════════
-- INTEGRITY GATE — `explicitRanges` and `defaultRanges` must equal a fresh parse
-- of the data lines and `@missing` lines of the pinned DerivedBidiClass.txt.
-- ═══════════════════════════════════════════════════════════════════════════════

/-- Raw text of `DerivedBidiClass.txt`, embedded at compile time. -/
def derivedBidiClassRaw : String := include_str "../Ucd/DerivedBidiClass.txt"

def cHexVal (c : Char) : Nat :=
  let n := c.toNat
  if n ≥ 0x30 ∧ n ≤ 0x39 then n - 0x30
  else if n ≥ 0x61 ∧ n ≤ 0x66 then n - 0x61 + 10
  else if n ≥ 0x41 ∧ n ≤ 0x46 then n - 0x41 + 10
  else 0
def cHex (s : String) : Nat := s.foldl (fun acc c => acc * 16 + cHexVal c) 0
def cTrim (s : String) : String := (String.trimAscii s).toString
def cRange (s : String) : Nat × Nat :=
  match (s.splitOn "..") with
  | [x]    => let n := cHex x; (n, n)
  | [a, b] => (cHex a, cHex b)
  | _irreg => (0, 0)

def cAbbrev : String → Option BidiClass
  | "L" => some .L | "R" => some .R | "AL" => some .AL | "EN" => some .EN
  | "ES" => some .ES | "ET" => some .ET | "AN" => some .AN | "CS" => some .CS
  | "NSM" => some .NSM | "BN" => some .BN | "B" => some .B | "S" => some .S
  | "WS" => some .WS | "ON" => some .ON | "LRE" => some .LRE | "LRO" => some .LRO
  | "RLE" => some .RLE | "RLO" => some .RLO | "PDF" => some .PDF | "LRI" => some .LRI
  | "RLI" => some .RLI | "FSI" => some .FSI | "PDI" => some .PDI | _o => none

def cFullName : String → Option BidiClass
  | "Left_To_Right" => some .L | "Right_To_Left" => some .R
  | "Arabic_Letter" => some .AL | "European_Terminator" => some .ET | _o => none

def cParseExplicit (line : String) : Option (Nat × Nat × BidiClass) :=
  if (cTrim line).startsWith "#" then none else
  match (line.splitOn ";") with
  | [rangeF, clsF] =>
    match cAbbrev (cTrim ((clsF.takeWhile (· != '#')).toString)) with
    | none => none
    | some cls => let (lo, hi) := cRange (cTrim rangeF); some (lo, hi, cls)
  | _other => none

def cParseMissing (line : String) : Option (Nat × Nat × BidiClass) :=
  match (line.splitOn "@missing:") with
  | [_pre, rest] =>
    match (rest.splitOn ";") with
    | [rangeF, nameF] =>
      match cFullName (cTrim nameF) with
      | none => none
      | some cls => let (lo, hi) := cRange (cTrim rangeF); some (lo, hi, cls)
    | _o => none
  | _o => none

def explicitRangesParsed : Array (Nat × Nat × BidiClass) :=
  (((derivedBidiClassRaw.splitOn "\n").filterMap cParseExplicit).toArray).qsort
    (fun a b => decide (a.1 < b.1))
def defaultRangesParsed : Array (Nat × Nat × BidiClass) :=
  ((derivedBidiClassRaw.splitOn "\n").filterMap cParseMissing).toArray

#eval do
  unless explicitRanges == explicitRangesParsed do
    throw (IO.userError "DerivedBidiClass drift: explicitRanges ≠ parsed")
  unless defaultRanges == defaultRangesParsed do
    throw (IO.userError "DerivedBidiClass drift: defaultRanges ≠ parsed @missing")

end Unicode.Generated.DerivedBidiClass
