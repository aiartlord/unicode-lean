def binarySearchRange (arr : Array (Nat × Nat × BidiClass)) (cp : Nat)
    (left right fuel : Nat) : Option BidiClass :=
  match fuel with
  | 0 => none
  | fuelNext + 1 =>
    if left < right then
      let mid := (left + right) / 2
      let row := arr[mid]!
      let lo := row.1
      let hi := row.2.1
      let cls := row.2.2
      if cp < lo then
        binarySearchRange arr cp left mid fuelNext
      else if hi < cp then
        binarySearchRange arr cp (mid + 1) right fuelNext
      else
        some cls
    else
      none

def lookupExplicitBinary (cp : Nat) : Option BidiClass :=
  binarySearchRange explicitRanges cp 0 explicitRanges.size (explicitRanges.size + 1)

def lookupDefault (cp : Nat) : Option BidiClass :=
  defaultRanges.foldl
    (fun acc row => if decide (row.1 ≤ cp ∧ cp ≤ row.2.1) then some row.2.2 else acc)
    none

/-- Full Bidi_Class lookup: explicit row first, then `@missing` defaults, then L. -/
def lookup (cp : Nat) : BidiClass :=
  match lookupExplicitBinary cp with
  | some cls => cls
  | none =>
    match lookupDefault cp with
    | some cls => cls
    | none => .L

